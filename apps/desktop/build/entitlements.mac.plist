<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime entitlements (P18.3). V8 needs JIT and writable
  executable memory in the main, renderer, and Core (utilityProcess)
  helpers. The app isn't sandboxed (it runs CLIs and Postgres), so no
  com.apple.security.app-sandbox. Every other hardened-runtime protection
  (library validation, DYLD variables, debugging) stays on.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
