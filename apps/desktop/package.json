{
  "name": "@agentic/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Agentic Hub: the macOS desktop app",
  "author": "Agentic Hub contributors",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "start": "install-electron && electron-vite preview",
    "check-types": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test:e2e": "electron-vite build && playwright test",
    "package": "pnpm --filter @agentic/cli bundle && electron-vite build && electron-builder"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "node-pty": "1.1.0",
    "ws": "8.22.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@agentic/client": "workspace:*",
    "@agentic/config": "workspace:*",
    "@agentic/contracts": "workspace:*",
    "@agentic/core": "workspace:*",
    "@agentic/db": "workspace:*",
    "@agentic/local-postgres": "workspace:*",
    "@agentic/logger": "workspace:*",
    "@agentic/ui": "workspace:*",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "zustand": "5.0.15"
  }
}
