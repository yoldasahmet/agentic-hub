{
  "name": "agentic-hub",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "lint": "biome check . && pnpm lint:layers && pnpm lint:size",
    "lint:layers": "depcruise --config .dependency-cruiser.cjs packages $(ls -d apps 2>/dev/null)",
    "lint:size": "node scripts/check-file-size.mjs",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @agentic/db db:generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @agentic/desktop test:e2e"
  },
  "devDependencies": {
    "@agentic/config": "workspace:*",
    "@agentic/testing": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "jsdom": "30.1.1",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
